(defn find-min [v]
  (letfn [(min? [v m]
            (if (empty? v)
              m
              (if (< (first v) m)
                (recur (rest v) (first v))
                (recur (rest v) m))))]
    (min? v (first v))))
clj꞉user꞉> 
(find-min [2 4 3 5])
clj꞉user꞉> 
(find-sum [1 2 3 4 5])
clj꞉user꞉> 
(defn find-sum [v]
  (loop [sum 0 vals v]
    (if (empty? vals)
      sum
      (recur (+ (first vals) sum) (rest vals)))))
clj꞉user꞉> 
(find-sum [1 2 3 4 5])
clj꞉user꞉> 
(defn palindrome? [v]
  (loop [vals v pallie true]
    (cond
      (empty? vals) pallie
      (= 1 (count vals)) pallie
      (= false pallie) pallie
      :else (recur
             (subvec vals 1 (- (count vals) 1))
             (= (first vals) (last vals))))))
