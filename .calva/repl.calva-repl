(defn count-words [phrase]
      (frequencies phrase)
  )
clj꞉user꞉> 
(count-words [:olly :in :olly :free :come])
clj꞉user꞉> 
(defn count-words [phrase]
  (loop [remaining phrase
         counts {} ]
    (if (empty? remaining)
      counts
      (let [word (first remaining)
            current-count (get counts word 0) ]
        (recur (rest remaining)
               (assoc counts word (inc current-count))
            ) )
      )
    )
  )
clj꞉user꞉> 
(count-words [:olly :in :olly :free :come])
