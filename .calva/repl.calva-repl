(defn is-even? [n]
  (if (= n 0)
    true
    (= false (is-even? (dec n)))
    )
  )
clj꞉user꞉> 
(= true (is-even? 0))
clj꞉user꞉> 
(= false (is-even? 1))
clj꞉user꞉> 
(defn is-even-bigint? [n]
  (loop [n   n
         acc true]
    (if (= n 0)
      true
      (= false (dec n) (not acc)))
    )
  )
