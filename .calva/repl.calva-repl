clj꞉user꞉> 
(defn recursive-reverse [coll]
  ;; reverse coll
  (loop [r (rest coll)
        acc (conj () (first coll)) ]
     (if (= (count r) 0)
       acc
       (recur (rest r) (conj acc (first r)))
       )
    )
  )
